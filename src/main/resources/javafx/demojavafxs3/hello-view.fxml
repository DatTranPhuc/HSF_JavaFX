<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.effect.DropShadow?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="450.0" spacing="25.0"
      style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f8f9fa);"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/24.0.1"
      fx:controller="javafx.demojavafxs3.controller.HelloController">
    <padding>
        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0"/>
    </padding>

    <!-- Header -->
    <Label text="ĐĂNG NHẬP"
           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #FF6600; -fx-letter-spacing: 2;"/>

    <Label text="Chào mừng bạn quay trở lại"
           style="-fx-font-size: 14px; -fx-text-fill: #6c757d; -fx-padding: 0 0 10 0;"/>

    <!-- Username Field -->
    <VBox spacing="8.0">
        <Label text="TÊN ĐĂNG NHẬP"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #495057; -fx-letter-spacing: 1;"/>
        <TextField fx:id="txtUserName"
                   promptText="Nhập tên đăng nhập"
                   style="-fx-background-color: white;
                          -fx-border-color: #e0e0e0;
                          -fx-border-width: 1.5;
                          -fx-border-radius: 10;
                          -fx-background-radius: 10;
                          -fx-padding: 12 15 12 15;
                          -fx-font-size: 14px;
                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <effect>
                <DropShadow radius="5" offsetY="2" color="#00000010"/>
            </effect>
        </TextField>
    </VBox>

    <!-- Password Field -->
    <VBox spacing="8.0">
        <Label text="MẬT KHẨU"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #495057; -fx-letter-spacing: 1;"/>
        <PasswordField fx:id="txtPassword"
                       promptText="Nhập mật khẩu"
                       style="-fx-background-color: white;
                              -fx-border-color: #e0e0e0;
                              -fx-border-width: 1.5;
                              -fx-border-radius: 10;
                              -fx-background-radius: 10;
                              -fx-padding: 12 15 12 15;
                              -fx-font-size: 14px;">
            <effect>
                <DropShadow radius="5" offsetY="2" color="#00000010"/>
            </effect>
        </PasswordField>
    </VBox>

    <!-- Welcome Message -->
    <Label fx:id="welcomeText"
           style="-fx-font-size: 15px; -fx-text-fill: #28a745; -fx-font-weight: 600; -fx-padding: 10 0 0 0;"/>

    <!-- Buttons -->
    <VBox spacing="12.0" style="-fx-padding: 10 0 0 0;">
        <Button fx:id="btnHello"
                onAction="#onHelloButtonClick"
                prefHeight="50.0" maxWidth="Infinity"
                text="ĐĂNG NHẬP"
                style="-fx-background-color: linear-gradient(to right, #FF6600, #ff8533);
                       -fx-text-fill: white;
                       -fx-font-size: 16px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 12;
                       -fx-cursor: hand;
                       -fx-letter-spacing: 1.5;">
            <effect>
                <DropShadow radius="8" offsetY="3" color="#FF660040"/>
            </effect>
        </Button>

        <Button fx:id="btnBye"
                onAction="#onByeByeClick"
                prefHeight="50.0" maxWidth="Infinity"
                text="HỦY BỎ"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #6c757d;
                       -fx-border-color: #dee2e6;
                       -fx-border-width: 1.5;
                       -fx-font-size: 15px;
                       -fx-font-weight: 600;
                       -fx-background-radius: 12;
                       -fx-border-radius: 12;
                       -fx-cursor: hand;
                       -fx-letter-spacing: 1.5;"/>
    </VBox>
</VBox>