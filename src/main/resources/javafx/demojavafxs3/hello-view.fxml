<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafx.demojavafxs3.controller.HelloController"
            style="-fx-background-color: #02CAA9; -fx-font-family: Arial;">
    <center>
        <VBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="40" right="60" bottom="40" left="60"/>
            </padding>
            <Label text="StudentName - Login Page"
                   style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;"/>

            <VBox spacing="12" alignment="CENTER_LEFT" style="-fx-pref-width: 400;">
                <Label text="Phone"
                       style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                <TextField fx:id="txtPhone" promptText="Enter phone number"
                           style="-fx-font-size: 18px; -fx-text-fill: #333333; -fx-background-radius: 8; -fx-padding: 8;"/>
            </VBox>

            <VBox spacing="12" alignment="CENTER_LEFT" style="-fx-pref-width: 400;">
                <Label text="Password"
                       style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                <PasswordField fx:id="txtPassword" promptText="Enter password"
                               style="-fx-font-size: 18px; -fx-text-fill: #333333; -fx-background-radius: 8; -fx-padding: 8;"/>
            </VBox>

            <Label fx:id="messageLabel"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnLogin" onAction="#onLoginClick" text="Login"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #02CAA9; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 8 30; -fx-background-radius: 20;"/>
                <Button fx:id="btnExit" onAction="#onExitClick" text="Exit"
                        style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 8 30; -fx-border-radius: 20;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
