<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafx.demojavafxs3.controller.SonyManagementController"
            style="-fx-background-color: #02CAA9; -fx-font-family: Arial;">
    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="30" bottom="10" left="30"/>
            </padding>
            <Label text="StudentName -  Sony Management Page"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label fx:id="welcomeLabel" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Logout" onAction="#onLogout"
                        style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 16px; -fx-border-radius: 20; -fx-padding: 6 20;"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="30" bottom="30" left="30"/>
            </padding>
            <TableView fx:id="productTable" prefHeight="350" style="-fx-border-color: white; -fx-background-color: rgba(255,255,255,0.15); -fx-table-cell-border-color: white;">
                <columns>
                    <TableColumn fx:id="colId" text="Product ID" prefWidth="100"/>
                    <TableColumn fx:id="colName" text="Product Name" prefWidth="240"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="120"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="100"/>
                    <TableColumn fx:id="colCreatedAt" text="Created At" prefWidth="160"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="160"/>
                </columns>
            </TableView>

            <VBox spacing="12" style="-fx-background-color: rgba(255,255,255,0.1); -fx-padding: 20; -fx-background-radius: 12;">
                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <Label text="Product Name" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                    <TextField fx:id="txtProductName" GridPane.rowIndex="0" GridPane.columnIndex="1"
                               promptText="Enter product name"
                               style="-fx-font-size: 18px; -fx-background-radius: 8; -fx-padding: 6;"/>

                    <Label text="Price" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                    <TextField fx:id="txtPrice" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               promptText="Enter price"
                               style="-fx-font-size: 18px; -fx-background-radius: 8; -fx-padding: 6;"/>

                    <Label text="Stock" GridPane.rowIndex="2" GridPane.columnIndex="0"
                           style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                    <TextField fx:id="txtStock" GridPane.rowIndex="2" GridPane.columnIndex="1"
                               promptText="Enter stock"
                               style="-fx-font-size: 18px; -fx-background-radius: 8; -fx-padding: 6;"/>

                    <Label text="Category" GridPane.rowIndex="3" GridPane.columnIndex="0"
                           style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                    <ComboBox fx:id="cboCategory" GridPane.rowIndex="3" GridPane.columnIndex="1"
                              style="-fx-font-size: 18px; -fx-background-radius: 8;"/>
                </GridPane>

                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="btnAdd" text="Add" onAction="#onAddProduct"
                            style="-fx-background-color: #ffffff; -fx-text-fill: #02CAA9; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 8 28; -fx-background-radius: 20;"/>
                    <Button fx:id="btnUpdate" text="Update" onAction="#onUpdateProduct"
                            style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 8 28; -fx-border-radius: 20;"/>
                    <Button fx:id="btnDelete" text="Delete" onAction="#onDeleteProduct"
                            style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 8 28; -fx-border-radius: 20;"/>
                    <Button fx:id="btnClear" text="Clear" onAction="#onClearForm"
                            style="-fx-background-color: transparent; -fx-border-color: white; -fx-text-fill: white; -fx-font-size: 18px; -fx-padding: 8 28; -fx-border-radius: 20;"/>
                </HBox>
                <Label fx:id="statusLabel" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Top 3 Products by Stock in Each Category"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <TableView fx:id="topProductsTable" prefHeight="200"
                           style="-fx-border-color: white; -fx-background-color: rgba(255,255,255,0.15); -fx-table-cell-border-color: white;">
                    <columns>
                        <TableColumn fx:id="colTopProductName" text="Product" prefWidth="260"/>
                        <TableColumn fx:id="colTopStock" text="Stock" prefWidth="120"/>
                        <TableColumn fx:id="colTopCategory" text="Category" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
